node_modules

# pnpm specific
.pnpm-store
.pnpm-debug.log

# npm lockfile (we use pnpm)
package-lock.json

# Ignore test fixtures
# but keep the directory
test/fixtures/*
!test/fixtures/index.js
!test/fixtures/assume-1.3.0.tgz

# All Apple files
.DS_Store

# Tests
test

# AI slop
.claude
.ai

