{
  "name": "baltar",
  "description": "A few small utilities for working with tarballs and http.",
  "version": "2.0.0",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "main": "./index.js",
  "types": "./index.d.ts",
  "bin": {
    "baltar": "./bin/cli.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "c8 mocha test/*.test.js",
    "test:coverage": "c8 --reporter=html --reporter=text mocha test/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/indexzero/baltar.git"
  },
  "keywords": [
    "tar",
    "http",
    "tarball",
    "untar",
    "tgz",
    "gzip",
    "esm",
    "undici",
    "streams"
  ],
  "author": "Charlie Robbins <charlie.robbins@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/indexzero/baltar/issues"
  },
  "homepage": "https://github.com/indexzero/baltar#readme",
  "dependencies": {
    "diagnostics": "^2.0.2",
    "ignore": "^7.0.5",
    "tar": "^7.5.1",
    "undici": "^7.16.0"
  },
  "devDependencies": {
    "assume": "^2.3.0",
    "async": "^3.2.6",
    "c8": "^10.1.3",
    "mocha": "^11.7.4",
    "retry": "^0.13.1",
    "rimraf": "^6.0.1"
  }
}
